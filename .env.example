# Server Configuration
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Database Configuration
# Provide a Postgres connection string (e.g., Neon, Supabase, Railway, or local Postgres).
# If left empty or set to "memory", the server uses an embedded in-memory Postgres engine (pg-mem) seeded automatically.
DATABASE_URL=

# Security & Auth Tokens (Separate Scopes)
# Token used by Chord to authenticate against the MCP Facade (/mcp)
MCP_BEARER_TOKEN=mcp_secret_token_change_me
# Token used by the swap station terminal to call POST /v1/passes/redeem
STATION_BEARER_TOKEN=station_secret_token_change_me
# Server secret used to sign and verify RPP1.<pass_id>.<mac> QR tokens (HMAC-SHA256)
PASS_HMAC_SECRET=ridepay_pass_hmac_secret_change_me_32bytes

# Paystack Configuration (Test Mode)
# Use your sk_test_... key from the Paystack Dashboard
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_test_secret_key
PAYSTACK_BASE_URL=https://api.paystack.co

# Business Rules & Pricing
SWAP_PRICE_NGN=750
MIN_PASS_QUANTITY=2
MAX_PASS_QUANTITY=10
ORDER_EXPIRY_MINUTES=30
PASS_VALIDITY_DAYS=30

# Rate Limiting for verify_rider
VERIFY_RIDER_MAX_FAILED_PER_MIN=5
VERIFY_RIDER_MAX_TOTAL_PER_MIN=15
